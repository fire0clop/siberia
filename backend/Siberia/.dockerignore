# Секреты — НИКОГДА не должны попадать в слои образа.
# Dockerfile делает COPY . . — без этого файла .env и .p8-ключи
# запекались в образ (и уезжали в registry при docker push).
.env
.env.*
!.env.example
secrets/
*.p8
*.p12
*.pem
*.key

# Мусор и локальные артефакты
.git/
.gitignore
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
.venv/
venv/
*.log
*.rdb

# Тесты и docker-обвязка не нужны внутри runtime-образа
tests/
docker-compose.yml
Dockerfile
.dockerignore
README.md
